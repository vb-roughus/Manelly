# Alles hier ist optional. Die Jellyfin-Verbindung trägst du am einfachsten
# direkt in der Oberfläche ein (Einstellungen) – das hat auch Vorrang.

# Jellyfin-Verbindung vorgeben (z. B. für automatisierte Installationen)
# JELLYFIN_URL=http://192.168.1.10:8096
# JELLYFIN_API_KEY=

# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
# Ordner für die gespeicherten Einstellungen (Standard: ./data)
# DATA_DIR=./data
