{
  "manifest_version": 3,
  "name": "Manelly Click'n'Load",
  "description": "Gibt Click'n'Load-Links an Manelly weiter, das sie dem JDownloader auf dem Jellyfin-Server übergibt.",
  "version": "1.0.0",
  "permissions": ["declarativeNetRequest", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "clicknload", "enabled": true, "path": "rules.json" }]
  },
  "web_accessible_resources": [{ "resources": ["jdcheck.js", "success.txt", "jdownloader.txt"], "matches": ["<all_urls>"] }],
  "action": { "default_title": "Manelly Click'n'Load", "default_popup": "options.html" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
