# Adresse deines Jellyfin-Servers – so, wie der Manelly-Server ihn erreicht.
# In Docker zeigt "localhost" auf den Container selbst: nimm die IP des Hosts.
JELLYFIN_URL=http://192.168.1.10:8096

# In Jellyfin: Dashboard → API-Schlüssel → "+" (z. B. Name "Manelly")
JELLYFIN_API_KEY=

# Optional
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
